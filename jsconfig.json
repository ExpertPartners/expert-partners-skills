{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["tools/skill-map/node_modules/@types"]
  },
  "include": [
    "tools/capability-feed/**/*.mjs",
    "tools/skill-map/**/*.mjs"
  ],
  "exclude": [
    "**/node_modules"
  ]
}
