{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ExpertPartners/expert-partners-skills/skills/visual-clearance/schemas/asset-record.schema.json",
  "title": "Visual Clearance asset record",
  "description": "One record per cleared, retired or rejected visual asset in the ExpertPartners/visual-assets register. Metadata and pointers only. Master files, evidence captures, contracts and correspondence live in their systems of record and are referenced by pointer. Never store secrets, correspondence bodies or personal contact details here. Cross-field rules are enforced by scripts/validate_record.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "status",
    "subject",
    "brand_scope",
    "source_class",
    "location_confidence",
    "location_evidence",
    "source_url",
    "original_file_pointer",
    "creator",
    "creator_contact_pointer",
    "capture_date",
    "original_filename",
    "dimensions",
    "sha256",
    "license",
    "license_url",
    "license_evidence_pointer",
    "attribution_required",
    "attribution_text",
    "permission_type",
    "permission_scope",
    "permission_expires",
    "release_state",
    "third_party_flags",
    "verified_on",
    "verified_by",
    "approval",
    "modifications",
    "derivatives",
    "usages",
    "review_due"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^VA-[0-9]{4}-[0-9]{4}$"
    },
    "status": {
      "enum": [
        "approved",
        "retired",
        "rejected"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "place_key": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "brand_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "source_class": {
      "enum": [
        "owned",
        "commissioned",
        "open_license",
        "platform_free",
        "paid_stock",
        "owner_permission",
        "mls_listing",
        "public_domain_government"
      ]
    },
    "location_confidence": {
      "enum": [
        "VERIFIED",
        "PROBABLE",
        "UNVERIFIED",
        "REJECT",
        "NOT_APPLICABLE"
      ]
    },
    "location_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "detail"
        ],
        "properties": {
          "type": {
            "enum": [
              "source_metadata",
              "embedded_gps",
              "landmark_match_official",
              "map_corroboration",
              "independent_corroboration",
              "reverse_image_earliest",
              "contradiction"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 3,
            "maxLength": 400
          },
          "pointer": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(https?://|drive:|gmail:|repo:|contract:)"
          }
        }
      }
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https?://"
    },
    "original_file_pointer": {
      "type": "string",
      "pattern": "^(https?://|drive:|repo:)"
    },
    "creator": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "creator_contact_pointer": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(https?://|drive:|gmail:|repo:|contract:)"
    },
    "capture_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "original_filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "license": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "description": "SPDX-style license id (CC-BY-SA-4.0, CC0-1.0), vendor license name (Adobe-Stock-Standard), or PERMISSION / OWNED when a written grant or ownership is the basis."
    },
    "license_url": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https?://"
    },
    "license_evidence_pointer": {
      "type": "string",
      "pattern": "^(https?://|drive:|gmail:|repo:|contract:)"
    },
    "attribution_required": {
      "type": "boolean"
    },
    "attribution_text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "permission_type": {
      "enum": [
        "none",
        "email",
        "contract",
        "license_purchase",
        "work_for_hire"
      ]
    },
    "permission_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses",
        "brands",
        "modifications_allowed"
      ],
      "properties": {
        "uses": {
          "type": "array",
          "items": {
            "enum": [
              "website",
              "social",
              "presentation",
              "print",
              "advertising",
              "listing",
              "email",
              "video"
            ]
          }
        },
        "brands": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "modifications_allowed": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 400
        }
      }
    },
    "permission_expires": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "release_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "property"
      ],
      "properties": {
        "model": {
          "enum": [
            "not_applicable",
            "released",
            "not_released",
            "unknown"
          ]
        },
        "property": {
          "enum": [
            "not_applicable",
            "released",
            "not_released",
            "unknown"
          ]
        },
        "pointer": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https?://|drive:|gmail:|repo:|contract:)"
        }
      }
    },
    "third_party_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flag",
          "resolved"
        ],
        "properties": {
          "flag": {
            "enum": [
              "people",
              "trademark_logo",
              "identifiable_home",
              "architecture",
              "private_property",
              "artwork",
              "security_features"
            ]
          },
          "resolved": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          }
        }
      }
    },
    "verified_on": {
      "type": "string",
      "format": "date"
    },
    "verified_by": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approved_on",
        "approval_pointer"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "approved_on": {
          "type": "string",
          "format": "date"
        },
        "approval_pointer": {
          "type": "string",
          "pattern": "^(https?://|drive:|gmail:|repo:|contract:)"
        }
      }
    },
    "modifications": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "derivatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pointer",
          "sha256"
        ],
        "properties": {
          "pointer": {
            "type": "string",
            "pattern": "^(https?://|drive:|repo:)"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          }
        }
      }
    },
    "usages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "where",
          "use",
          "brand",
          "since",
          "represents_named_place"
        ],
        "properties": {
          "where": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "use": {
            "enum": [
              "website",
              "social",
              "presentation",
              "print",
              "advertising",
              "listing",
              "email",
              "video"
            ]
          },
          "brand": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "since": {
            "type": "string",
            "format": "date"
          },
          "until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "represents_named_place": {
            "type": "boolean"
          }
        }
      }
    },
    "review_due": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 600
    }
  }
}
