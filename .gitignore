# macOS Finder metadata
.DS_Store
.DS_Store?
._*

# Editor / IDE
.vscode/
.idea/
*.swp

# Skills-local secrets
*.local.env
*.secret

# Environment files hold real secrets. Templates stay trackable.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc

# Python bytecode, virtual environments and tool caches
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.eggs/

# JavaScript dependencies, logs and caches
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
*.tsbuildinfo
.nyc_output/
coverage/

# Reproducible local build output. Producer-owned artifacts such as
# tools/capability-feed/ai-workforce-feed.json and tools/skill-map/skills-graph.json
# are tracked files, not build directories, and stay tracked.
build/
dist/
.cache/
