{
  "description": "Headless route check for browser navigation, and the standing yes that every session starts with.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__.*__(browser_navigate|navigate|tabs_create_mcp|browser_tabs|browser_run_code_unsafe|browser_run_code|browser_evaluate)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/headless_route_check.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/standing_yes.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
